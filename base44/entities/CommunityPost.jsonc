{
  "name": "CommunityPost",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email dell'autore del post"
    },
    "user_name": {
      "type": "string",
      "description": "Nome dell'autore"
    },
    "user_photo_url": {
      "type": "string",
      "description": "Foto profilo dell'autore"
    },
    "media_url": {
      "type": "string",
      "description": "URL del media caricato"
    },
    "caption": {
      "type": "string",
      "description": "Didascalia del post"
    },
    "gym_id": {
      "type": "string",
      "description": "ID della palestra (opzionale)"
    },
    "gym_name": {
      "type": "string",
      "description": "Nome della palestra (opzionale)"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "only_me",
        "friends",
        "friends_nearby",
        "community"
      ],
      "default": "friends",
      "description": "Visibilit\u00e0 del post"
    },
    "show_gym_name": {
      "type": "boolean",
      "default": false,
      "description": "Mostra nome palestra nel post"
    },
    "safety_score": {
      "type": "number",
      "default": 0,
      "description": "Punteggio sicurezza (0-10)"
    },
    "boost_count": {
      "type": "number",
      "default": 0,
      "description": "Numero di boost (denormalizzato)"
    },
    "comment_count": {
      "type": "number",
      "default": 0,
      "description": "Numero di commenti (denormalizzato)"
    },
    "created_date": {
      "type": "string",
      "format": "date-time",
      "description": "Quando \u00e8 stato creato il post"
    }
  },
  "required": [
    "user_email",
    "user_name",
    "media_url"
  ]
}