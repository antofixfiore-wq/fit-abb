{
  "name": "UserReport",
  "type": "object",
  "properties": {
    "reporter_email": {
      "type": "string",
      "description": "Email di chi segnala"
    },
    "reported_user_email": {
      "type": "string",
      "description": "Email dell'utente segnalato"
    },
    "reported_post_id": {
      "type": "string",
      "description": "ID del post segnalato (opzionale)"
    },
    "target_type": {
      "type": "string",
      "enum": [
        "post",
        "user"
      ],
      "description": "Tipo di target segnalato"
    },
    "reason": {
      "type": "string",
      "enum": [
        "nudity",
        "hate",
        "spam",
        "other"
      ],
      "description": "Motivo della segnalazione"
    },
    "notes": {
      "type": "string",
      "description": "Note aggiuntive"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "actioned",
        "dismissed"
      ],
      "default": "open",
      "description": "Stato della segnalazione"
    },
    "admin_notes": {
      "type": "string",
      "description": "Note dell'admin"
    },
    "created_date": {
      "type": "string",
      "format": "date-time",
      "description": "Quando \u00e8 stata creata la segnalazione"
    }
  },
  "required": [
    "reporter_email",
    "target_type",
    "reason"
  ]
}